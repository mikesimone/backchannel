# Copy to .env and edit.

# Owner of the data folder (run `id -u`).
BACKCHANNEL_UID=1000

# Where your Signal profile and keys live. Keep it private and back it up.
BACKCHANNEL_DATA=/var/lib/backchannel

# Once the page is behind your HTTPS reverse proxy, its address:
# BACKCHANNEL_ORIGIN=https://chat.example.net

# Release to build. Leave it unset to use the one this checkout pins.
# BACKCHANNEL_REF=backchannel-v1.9
